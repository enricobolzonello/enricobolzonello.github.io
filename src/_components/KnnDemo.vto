<figure class="c-knn"
        data-n="{{ it.n ?? 100}}" data-k="{{ it.k ?? 5}}"
        data-eps="{{ it.eps ?? 0.3}}" data-seed="{{ it.seed ?? 20250401 }}"
        role="group" aria-label="Interactive figure: exact and approximate nearest neighbours of a query point">
    <svg class="c-knn__plot" viewBox="0 0 640 400" tabindex="0"
         aria-label="Scatter plot. Click, drag, or use the arrow keys to move the query point."></svg>
    <div class="c-knn__controls">
        <label>ε = <output class="c-knn__eps-out"></output>
            <input type="range" name="eps" min="0" max="1" step="0.01"></label>
        <label>K = <output class="c-knn__k-out"></output>
            <input type="range" name="k" min="1" max="20" step="1"></label>
    </div>
    <figcaption class="c-knn__legend" aria-live="polite"></figcaption>
</figure>
<script src="/js/knn-demo.js" type="module"></script>
